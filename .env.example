# Copy to .env (docker compose reads it) and/or set these as environment variables before starting the backend.
# Never commit real credentials.

# --- Backend (Spring Boot) ---
DB_URL=jdbc:mysql://localhost:3306/medisync_live?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=medisync
DB_PASSWORD=medisync
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Integration tests (optional; default is localhost:3306/medisync_test with DB_USERNAME/DB_PASSWORD) ---
# TEST_DB_URL=jdbc:mysql://localhost:3306/medisync_test?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# TEST_DB_USERNAME=medisync
# TEST_DB_PASSWORD=medisync

# --- Docker MySQL only ---
MYSQL_ROOT_PASSWORD=medisync_root

# --- Frontend (optional; the Vite dev server proxies /api and /ws to localhost:8080 by default) ---
# VITE_BACKEND_URL=http://localhost:8080
# VITE_API_BASE_URL=
# VITE_WS_URL=
